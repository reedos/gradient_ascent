---
interface Props { lesson?: string }
const { lesson } = Astro.props;
import { lessons } from '../lib/learning';
import { url } from '../lib/url';
---
<div class="learning-progress" data-learning-progress data-lesson={lesson} data-base={url('/learn/')}>
  <p data-progress-status role="status">Progress is saved only in this browser. It does not sync across devices.</p>
  <progress max={lessons.length} value="0" aria-label="Lessons marked complete"></progress>
  {lesson && <button class="button" type="button" data-complete disabled aria-pressed="false">Mark lesson complete</button>}
  <a class="text-link" data-resume href={url(`/learn/${lessons[0].id}/`)}>Start the path →</a>
  <noscript><p>You can read every lesson and answer without JavaScript. Progress saving requires JavaScript.</p></noscript>
</div>
<script>
  import { lessons, parseProgress, nextIncomplete } from '../lib/learning';
  const key = 'ga:learning:v1';
  for (const root of document.querySelectorAll<HTMLElement>('[data-learning-progress]')) {
    const status = root.querySelector<HTMLElement>('[data-progress-status]')!;
    const progress = root.querySelector('progress')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-complete]');
    const resume = root.querySelector<HTMLAnchorElement>('[data-resume]')!;
    let done: string[] = [];
    let saved = true;
    try { done = parseProgress(localStorage.getItem(key)); } catch { saved = false; }
    function render() {
      status.textContent = `${done.length} of ${lessons.length} lessons marked complete. ${saved ? 'Saved only in this browser; not synced across devices.' : 'Storage is unavailable; progress lasts for this page only.'}`;
      progress.value = done.length;
      const next = nextIncomplete(done);
      resume.href = next ? `${root.dataset.base}${next.id}/` : root.dataset.base!;
      resume.textContent = next ? (done.length ? `Continue: ${next.title} →` : 'Start the path →') : 'All lessons marked complete · revisit projects →';
      if (toggle) {
        const complete = done.includes(root.dataset.lesson!);
        toggle.disabled = false;
        toggle.textContent = complete ? 'Completed · mark incomplete' : 'Mark lesson complete';
        toggle.setAttribute('aria-pressed', String(complete));
      }
      for (const badge of document.querySelectorAll<HTMLElement>('[data-lesson-badge]')) {
        badge.textContent = done.includes(badge.dataset.lessonBadge!) ? 'Completed' : 'Not yet completed';
      }
    }
    toggle?.addEventListener('click', () => {
      const id = root.dataset.lesson!;
      done = done.includes(id) ? done.filter(x => x !== id) : [...done, id];
      try { localStorage.setItem(key, JSON.stringify(done)); } catch { saved = false; }
      render();
    });
    window.addEventListener('storage', event => {
      if (event.key === key || event.key === null) { done = parseProgress(event.newValue); render(); }
    });
    render();
  }
</script>
<style>
  .learning-progress { padding: 22px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); display: flex; flex-wrap: wrap; align-items: center; gap: 18px; margin: 26px 0; }
  p { width: 100%; font-size: 13px; color: var(--muted); }
  progress { width: 100%; height: 9px; accent-color: var(--accent); }
  button { cursor: pointer; }
  button[aria-pressed='true'] { background: var(--panel2); color: var(--text); }
  a { font-size: 13px; }
  @media print { button, progress, [data-resume] { display: none; } }
</style>

---
import { usDate } from '../lib/dates';
// The footer carries the whole site map, built from the same src/lib/nav.ts the header's menus
// read. It is also where the phone's Menu link lands when JavaScript is off.
import Logo from './Logo.astro';
import { asOf, levels, tracks, threads } from '../lib/content';
import { url } from '../lib/url';
import { buildNav, type NavLevel, type NavTrack } from '../lib/nav';
import { REPO_URL } from '../lib/site';

const navLevels: NavLevel[] = levels.map((l) => ({ order: l.order, title: l.title, short: l.short, slugs: l.pages.map((p) => p.slug) }));
const navTracks: NavTrack[] = tracks.map((t) => ({ id: t.id, title: t.title, slugs: (t.pages ?? []).map((p) => p.slug) }));
const groups = buildNav(navLevels, navTracks, threads.map((t) => ({ id: t.id, title: t.title })));
---
<footer class="site-footer">
  <nav class="footer-map" id="sitemap" aria-label="Site map">
    {
      groups.map((g) => (
        <div class="footer-map-col">
          <h2>{g.label}</h2>
          <ul>
            {g.sections.flatMap((s) => s.items).map((it) => (
              <li>
                <a href={url(it.path)} style={it.level !== undefined ? `--c:var(--o${it.level})` : undefined}>
                  {it.level !== undefined && <span class="footer-map-n">{it.level}</span>}
                  {it.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="footer-top">
    <span class="brand">
      <Logo id="footer" size={26} />
      <span>gradient<span class="brand-light">ascent</span><span class="brand-dot">.</span></span>
    </span>
    <p>Every way to work with AI, from a question to a workforce.</p>
  </div>

  <nav class="footer-links" aria-label="Project links">
    <a href={url('/method/')}>Sources &amp; methodology</a>
    <a href={REPO_URL} rel="noopener">Source on GitHub ↗</a>
    <a href={url('/llms.txt')}>Use with your AI</a>
    <a href={`${REPO_URL}/issues/new?template=feedback.yml`} rel="noopener">Suggest a correction ↗</a>
  </nav>

  <p class="project-attribution"><strong>An independent project by Reed Cameron Osaki.</strong></p>

  <div class="project-details">
    <p>Models, products and tools listed as of {usDate(asOf)}.</p>
    <details>
      <summary>Content sources &amp; verification</summary>
      <p>Levels, topics, recipes and page relationships come from <code>content/taxonomy.json</code>.
        Model and tool listings come from <code>content/landscape.json</code>.
        Every page is marked sourced until a recorded run and a scored result stand behind it.</p>
    </details>
  </div>
  <div class="footer-bottom">
    <p>Independent. Open source. MIT licensed.</p>
    <a href={url('/search/')}>Search the guide</a>
  </div>
</footer>

<style>
  .site-footer { width: calc(100% - 96px); margin-left: auto; margin-right: auto }
  .footer-map { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 32px; margin: 0 0 34px; padding-bottom: 34px; border-bottom: 1px solid var(--line) }
  .footer-map h2 { font: 600 10px/1 var(--font); letter-spacing: 1.6px; text-transform: uppercase; color: var(--muted); margin: 0 0 12px }
  .footer-map ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px }
  .footer-map a { font-size: 12.5px; color: var(--muted); display: inline-flex; align-items: baseline; gap: 8px; transition: color .15s }
  .footer-map a:hover { color: var(--text) }
  .footer-map-n { font: 600 11px var(--display); color: var(--c); font-variant-numeric: tabular-nums; min-width: 8px }
  .footer-top { flex-direction: column; align-items: flex-start; gap: 15px }
  .footer-top p { font-size: 11px }
  .footer-links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 20px; font-size: 10px; color: var(--muted) }
  .footer-links a:hover, .footer-bottom a:hover { color: var(--text) }
  .project-details { border-top: 1px solid var(--line); padding: 20px 0; font-size: 10px; line-height: 1.9; color: var(--muted) }
  .project-details summary { cursor: pointer; margin-top: 12px }
  .project-details details p { max-width: 75ch; margin-top: 12px }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 0; font-size: 9px }
  .footer-bottom a { color: var(--muted) }
  .project-attribution { margin: 24px 0; color: var(--muted); font-size: 12px; line-height: 1.9 }
  .project-attribution strong { color: var(--text); font-weight: 600 }
  @media (max-width: 850px) { .site-footer { width: calc(100% - 40px) } .footer-map { grid-template-columns: 1fr 1fr } }
</style>

---
const lenses:Record<string,{title:string;intro:string;cards:{label:string;flow:string[];meaning:string;limit:string}[]}>={
 'what-the-model-sees':{title:'Stored somewhere is not the same as seen now.',intro:'The model works from the context actually supplied to this request. These are different ways to assemble it.',cards:[{label:'Context for this call',flow:['Instructions + current input','Select and fit','Model request'],meaning:'Choose relevant evidence and instructions within the available context.',limit:'More context can add distractors and cost.'},{label:'Memory across calls',flow:['Selected prior information','Store, update, retrieve','Current context'],meaning:'Persist useful facts or state, then retrieve what this request needs.',limit:'Stored memory can be stale, wrong, or inappropriate to retain.'},{label:'Work across sessions',flow:['Task state + artifacts','Checkpoint and resume','Next work session'],meaning:'Carry progress, blockers, and inspectable artifacts into the next session.',limit:'A summary alone is not an action receipt or proof the task finished.'}]},
 'who-approves-what':{title:'A proposal crosses a boundary before it becomes an action.',intro:'Keep these three decisions separate, whether the system is a workflow, one agent, or a team.',cards:[{label:'Propose',flow:['Task + evidence','Model drafts an action','Exact proposed payload'],meaning:'A model can suggest what to do without having authority to do it.',limit:'Tool selection is not permission.'},{label:'Authorize',flow:['Payload + scope + version','Policy and human review','Bounded approval'],meaning:'Approve a specific action and destination under current conditions.',limit:'Changed content or expired consent needs a fresh check.'},{label:'Execute and verify',flow:['Recheck current state','Run with an idempotency key','Inspect receipt and outcome'],meaning:'Record what actually happened, including uncertain or partial results.',limit:'Retrying after an ambiguous failure can duplicate the action.'}]},
 'checking-the-work':{title:'Three questions. Three different kinds of evidence.',intro:'These checks complement each other; they are not a progression from weak to strong.',cards:[{label:'Is the record valid?',flow:['Returned data','Schema + deterministic rules','Accept or reject the record'],meaning:'Check types, required fields, arithmetic, permissions, and source IDs.',limit:'A valid record can contain false claims.'},{label:'Did the task succeed?',flow:['Task + outcome','Rubric or external check','Quality judgment'],meaning:'Grade usefulness, factual support, completeness, and unwanted effects.',limit:'A model grader needs calibration; agreement is not proof.'},{label:'Where did it go wrong?',flow:['Observed run events','Trace + artifact inspection','Failure diagnosis'],meaning:'Follow the evidence, tool calls, state changes, and errors behind an outcome.',limit:'Telemetry alone does not establish answer quality.'}]},
};
const lens=lenses[Astro.props.slug];
---
{lens&&<figure class="thread-lens"><header><span class="eyebrow">Compare the mechanisms</span><h2>{lens.title}</h2><p>{lens.intro}</p></header><div class="lens-grid">{lens.cards.map(card=><section><h3>{card.label}</h3><ol>{card.flow.map((step,i)=><li><span>{i+1}</span>{step}</li>)}</ol><p>{card.meaning}</p><p class="lens-limit"><b>Boundary</b>{card.limit}</p></section>)}</div></figure>}
<style>.thread-lens{margin:24px 0 36px}header{max-width:820px;margin-bottom:24px}.eyebrow{color:var(--ot);font-size:10px}h2{font-size:clamp(24px,2.7vw,32px);line-height:1.3;letter-spacing:-.5px;margin:12px 0}header p{color:var(--muted);font-size:15px;line-height:1.8}.lens-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.lens-grid section{border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:24px}.lens-grid h3{font-size:18px;margin-bottom:22px}.lens-grid ol{list-style:none;padding:0;margin:0 0 24px}.lens-grid li{position:relative;display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line-control);border-radius:7px;font-size:13px;min-height:58px;background:var(--panel2)}.lens-grid li+li{margin-top:25px}.lens-grid li+li:before{content:'↓';position:absolute;left:50%;top:-24px;color:var(--ot)}.lens-grid li span{font-size:10px;color:var(--ot)}.lens-grid p{font-size:13px;line-height:1.8;color:var(--muted)}.lens-limit{margin-top:20px;border-top:1px solid var(--line);padding-top:15px}.lens-limit b{display:block;color:var(--text);font-size:11px;margin-bottom:4px}@media(max-width:800px){.lens-grid{grid-template-columns:1fr}.lens-grid section{padding:20px}.lens-grid li{min-height:48px}.lens-grid ol{margin-bottom:18px}}</style>

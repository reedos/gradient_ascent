---
import { url } from '../lib/url';
const graphs = [
  { id: 'facts', level: 2, title: 'Knowledge graph', href: 'knowledge-graphs', note: 'Nodes are things. Edges state how they relate.', example: 'Follow facts to find which supplier a product depends on.', nodes: ['Product', 'Part', 'Supplier'], edges: ['contains', 'supplied by'] },
  { id: 'steps', level: 3, title: 'Workflow graph', href: 'workflow-graphs', note: 'Nodes are steps. Code sets the transitions.', example: 'A fixed rule sends a failed check back for revision.', nodes: ['Draft', 'Check', 'Publish'], edges: ['submit', 'pass'] },
  { id: 'agents', level: 6, title: 'Agent graph', href: 'agent-graphs', note: 'Nodes are agents. A model chooses a handoff.', example: 'The lead chooses among these routes; it need not call both specialists.', nodes: ['Lead', 'Researcher', 'Reviewer'], edges: ['delegate', 'delegate'] },
];
---
<section class="graph-comparison" aria-labelledby="graph-comparison-title">
  <h2 id="graph-comparison-title">Same shapes, different connections</h2>
  <p class="intro">Three illustrative graphs. Read the labels on the arrows: they tell you what each connection means.</p>
  <div class="graphs">
    {graphs.map(g => <figure style={`--graph-color:var(--o${g.level})`}>
      <div class="level">Level {g.level}</div>
      <h3><a href={url(`/techniques/${g.href}/`)}>{g.title} <span aria-hidden="true">↗</span></a></h3>
      <p class="meaning">{g.note}</p>
      <svg viewBox="0 0 320 265" role="img" aria-labelledby={`${g.id}-title ${g.id}-desc`}>
        <title id={`${g.id}-title`}>{g.title} example</title>
        <desc id={`${g.id}-desc`}>{g.id === 'facts' ? 'Product contains Part. Part is supplied by Supplier.' : g.id === 'steps' ? 'Draft goes to Check. A passing check goes to Publish. A failed check returns to Draft.' : 'Lead can delegate to Researcher or Reviewer. Each returns findings to Lead. These are available routes, not a required sequence.'}</desc>
        <defs><marker id={`${g.id}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="var(--graph-color)" /></marker></defs>
        {g.id === 'agents' ? <>
          <path class="edge" d="M130 62L78 161" marker-end={`url(#${g.id}-arrow)`}/>
          <path class="edge" d="M190 62L242 161" marker-end={`url(#${g.id}-arrow)`}/>
          <text x="126" y="121">delegate</text><text x="194" y="121">delegate</text>
          <path class="edge return" d="M45 164Q10 62 104 43" marker-end={`url(#${g.id}-arrow)`}/>
          <path class="edge return" d="M275 164Q310 62 216 43" marker-end={`url(#${g.id}-arrow)`}/>
          <g class="node"><rect x="104" y="20" width="112" height="42" rx="8"/><text x="160" y="46">Lead</text></g>
          <g class="node"><rect x="14" y="164" width="136" height="42" rx="8"/><text x="82" y="190">Researcher</text></g>
          <g class="node"><rect x="170" y="164" width="136" height="42" rx="8"/><text x="238" y="190">Reviewer</text></g>
          <text class="key" x="160" y="244">Dashed arrows return findings</text>
        </> : <>
          <path class="edge" d="M160 54V102" marker-end={`url(#${g.id}-arrow)`}/>
          <path class="edge" d="M160 146V194" marker-end={`url(#${g.id}-arrow)`}/>
          <text x="218" y="83">{g.edges[0]}</text><text x="221" y="175">{g.edges[1]}</text>
          {g.id === 'steps' && <><path class="edge return" d="M100 124H42V33H100" marker-end={`url(#${g.id}-arrow)`}/><text x="46" y="151">fail: revise</text></>}
          {g.nodes.map((node,i) => <g class="node"><rect x="100" y={12+i*92} width="120" height="42" rx="8"/><text x="160" y={38+i*92}>{node}</text></g>)}
        </>}
      </svg>
      <figcaption>{g.example}</figcaption>
    </figure>)}
  </div>
</section>
<style>
  .graph-comparison { margin: 32px 0 44px; }
  h2 { font-size: 24px; line-height: 1.3; }
  .intro { color: var(--muted); font-size: 14px; margin: 10px 0 20px; }
  .graphs { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  figure { margin: 0; padding: 20px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
  .level { color: var(--graph-color); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 8px; }
  h3 { font-size: 17px; margin: 0; }
  h3 a { color: var(--text); }
  h3 span { color: var(--graph-color); }
  .meaning, figcaption { font-size: 13px; line-height: 1.6; color: var(--muted); }
  .meaning { margin: 10px 0 0; min-height: 42px; }
  svg { display: block; width: 100%; height: auto; margin: 10px 0; overflow: visible; }
  .edge { fill: none; stroke: var(--graph-color); stroke-width: 1.7; }
  .return { stroke-dasharray: 4 4; }
  text { fill: var(--muted); font-family: inherit; font-size: 12px; text-anchor: middle; }
  .node rect { fill: var(--bg); stroke: var(--graph-color); stroke-width: 1.3; }
  .node text { fill: var(--text); font-size: 14px; }
  .key { font-size: 11px; }
  @media (max-width: 850px) { .graphs { grid-template-columns: 1fr; } svg { max-width: 360px; margin-inline: auto; } .meaning { min-height: 0; } }
</style>

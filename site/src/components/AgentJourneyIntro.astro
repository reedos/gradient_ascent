---
import { levels } from '../lib/content';
import { agentJourney } from '../lib/agent-journey';
import { url } from '../lib/url';
---
<section class="journey-intro" aria-labelledby="journey-intro-title">
  <div><div class="eyebrow muted">Start with the basics</div><h2 id="journey-intro-title">From a chatbot to an always-on agent</h2>
  <p>See how conversational AI expanded through stronger reasoning, retrieval, workflows, tools, agent loops, and systems that keep working across sessions.</p></div>
  <a class="text-link" href={url('/chatbot-to-agent/')}>See the technology evolve <span aria-hidden="true">→</span></a>
  <ol aria-label="Capabilities covered">{agentJourney.map((step,i) => <li><a href={url(`/chatbot-to-agent/#step-${i+1}`)}><span>{i+1}</span> {levels.find(level => level.order === i+1)?.title}</a></li>)}</ol>
  <p class="note">Overlapping developments, explained through seven levels. Teams are optional.</p>
</section>
<style>
.journey-intro { padding: 28px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: 18px 28px; }
h2 { font-size: 25px; line-height: 1.3; margin-top: 8px; }
p { color: var(--muted); font-size: 14px; max-width: 76ch; margin-top: 10px; }
.text-link { align-self: center; }
ol { grid-column: 1/-1; display: flex; flex-wrap: wrap; gap: 10px 20px; list-style: none; padding: 0; margin: 0; }
li a { font-size: 13px; color: var(--text); } li span { color: var(--accent); margin-right: 4px; }
.note { grid-column: 1/-1; font-size: 12px; margin: 0; }
@media(max-width:700px) { .journey-intro { grid-template-columns: 1fr; } h2 { font-size: 22px; } }
</style>

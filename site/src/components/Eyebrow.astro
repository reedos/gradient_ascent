---
interface Props {
  label: string;
  color?: string;
  muted?: boolean;
  /** The prototype puts a dot on a page's own eyebrow, but not on section eyebrows. */
  dot?: boolean;
}
const { label, color, muted = false, dot = true } = Astro.props;
// A level color tints the whole eyebrow, the way the level panel does on the home page.
const style = color ? `--c:${color};color:${color}` : undefined;
---
<div class:list={['eyebrow', { muted }]} style={style}>
  {dot && <span class="dot"></span>}{label}
</div>

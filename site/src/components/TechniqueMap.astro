---
// The whole technique graph: every /techniques/<slug>/ page as a node, positioned once at build
// time by src/lib/map.ts (eight level bands, level 7 on top to level 0 on the bottom, plus a
// ninth band for the five cross-cutting topics), with the taxonomy's typed relations drawn as
// edges. No client layout and no physics -- the same static-SVG approach ClimbCurve.astro and
// Timeline.astro use for their own build-time figures.
//
// `requires` and `upgrades_to` draw by default; `combines_with` and `alternative_to` are frequent
// enough to turn the drawing into a hairball, so they stay off until a reader turns on one of the
// checkboxes below (pure CSS, :has()) or focuses a concept. The script isolates its connections;
// Concept links and relationship filters remain available without JavaScript.
import { url } from '../lib/url';
import { mapLayout, mapConnections, upgradeCoveredRequirements, edgePathD, RELATION_LABEL, type RelationType } from '../lib/map';
import '../styles/map.css';

const layout = mapLayout;
const coveredRequirements = upgradeCoveredRequirements(layout.edges);

const RELATION_ORDER: RelationType[] = ['requires', 'upgrades_to', 'combines_with', 'alternative_to'];
const edgeCount: Record<RelationType, number> = { requires: 0, upgrades_to: 0, combines_with: 0, alternative_to: 0 };
for (const e of layout.edges) edgeCount[e.type]++;

const FILTER_ID: Record<RelationType, string> = {
  requires: 'map-f-requires',
  upgrades_to: 'map-f-upgrades',
  combines_with: 'map-f-combines',
  alternative_to: 'map-f-alt',
};
// requires and upgrades_to draw by default; the other two start off, per the brief above.
const CHECKED_BY_DEFAULT: Record<RelationType, boolean> = {
  requires: true,
  upgrades_to: true,
  combines_with: false,
  alternative_to: false,
};

const bySlug = new Map(layout.nodes.map((n) => [n.slug, n]));
const drawableEdges = mapConnections(layout)
  .map((e) => {
    const fromNode = bySlug.get(e.from)!;
    const toNode = bySlug.get(e.to)!;
    // A straight (or midpoint-only) line between two nodes in the same row would run right
    // through anything sitting between them -- computeEdgeGeometry arcs it clear instead.
    return { ...e, fromNode, toNode, d: edgePathD(e.geometry) };
  })
  // requires and upgrades_to first, so they sit under combines_with/alternative_to when a reader
  // turns those on -- the rarer, hover-revealed lines read as an overlay, not the base picture.
  .sort((a, b) => RELATION_ORDER.indexOf(a.type) - RELATION_ORDER.indexOf(b.type));
---

<div class="map-wrap">
<div class="map-filters panel" role="group" aria-label="Which relations to draw">
  <details class="map-options" open>
  <summary>Filters &amp; reading tips</summary>
  <p class="map-filters-label">Relations to draw</p>
  <div class="map-filters-row">
    {
      RELATION_ORDER.map((type) => (
        <label class="filter-check" data-type={type}>
          <input type="checkbox" id={FILTER_ID[type]} checked={CHECKED_BY_DEFAULT[type]} />
          <span class="map-swatch" data-type={type} aria-hidden="true" />
          {RELATION_LABEL[type]} <span class="map-filter-count">({edgeCount[type]} total)</span>
        </label>
      ))
    }
  </div>
  <p class="footnote">
    {coveredRequirements.size} prerequisite connections also have an upgrade path, so they draw once as Upgrades to.
    Turn off Upgrades to to see those Requires lines. Hover, tab, or choose a concept to reveal all its
    connections, including supporting topics such as guardrails and evaluation.
  </p>
  <p class="footnote">Combines with and Alternative to start off to keep the overview readable. Topics apply across levels;
    the map highlights useful direct connections, not every possible combination. An upgrade is a next step when needed, not a universal prerequisite.</p>
  </details>
  <div class="map-focus-controls">
  <label class="map-focus-label" for="map-focus">Focus on a concept</label>
  <select id="map-focus" disabled><option value="">All concepts</option>{[...layout.nodes].sort((a, b) => a.title.localeCompare(b.title)).map(n => <option value={n.slug}>{n.title}</option>)}</select>
  <p class="map-focus-status" aria-live="polite">Hover to explore. Click a concept to lock its connections, then open its page in the selection panel.</p>
  <button type="button" class="map-clear" hidden>Clear selection</button>
  <a class="map-selection-jump" href="#map-selection" hidden>Read why these concepts connect →</a>
  </div>
  <noscript><p class="footnote">JavaScript is off. Concept boxes open their pages directly; the relationship filters still work.</p></noscript>
</div>

<details class="map-legend" open>
  <summary><span>Line meanings</span><span class="map-mobile-key">{RELATION_ORDER.map(type=><span><i class="map-swatch" data-type={type} aria-hidden="true" />{RELATION_LABEL[type]}</span>)}</span></summary>
  <h3 class="map-legend-heading">What each line means</h3>
  <p class="map-reading-key">Hover or focus to trace connections. Click or press Enter to lock a selection; read why each concept connects in the selection panel. Crossing lines are not joined. Select a concept to see the direction and explanation of each connection.</p>
  <dl class="map-legend-list">
    {
      RELATION_ORDER.map((type) => (
        <div class="map-legend-row">
          <dt>
            <span class="map-swatch" data-type={type} aria-hidden="true" />
            {RELATION_LABEL[type]}
          </dt>
          <dd>{({ requires: 'A foundation to understand first; not always a runtime dependency.', upgrades_to: 'A next approach when the simpler one reaches a specific limit.', combines_with: 'Used together: each contributes a different part of the solution.', alternative_to: 'Different approaches to compare for the same need.' })[type]}</dd>
        </div>
      ))
    }
  </dl>
</details>

<div class="map-workspace">
<div class="map-row">
  <div class="map-labels" style={`height:${layout.height}px`}>
    {
      layout.bands.map((band) => (
        <div
          class="map-band-label"
          data-kind={band.kind}
          style={`top:${band.y}px;height:${band.h}px;--map-band-top:${band.y / layout.height * 100}%;--map-band-height:${band.h / layout.height * 100}%;--c:${band.kind === 'level' ? `var(--o${band.level})` : 'var(--ot)'}`}
          title={band.shortTitle}
        >
          {band.kind === 'level' && <span class="map-band-num">{String(band.level).padStart(2, '0')}</span>}
          <span class="map-band-title">{band.shortTitle}</span>
        </div>
      ))
    }
  </div>

  <div class="map-scroll">
    <svg
      class="map-svg"
      width={layout.width}
      height={layout.height}
      viewBox={`0 0 ${layout.width} ${layout.height}`}
      role="group"
      aria-labelledby="map-svg-title map-svg-desc"
    >
      <title id="map-svg-title">The technique graph</title>
      <desc id="map-svg-desc">
        {layout.nodes.length} techniques across eight levels and five wrapped topic rows, connected by {layout.edges.length} relations.
        Select a concept to read its relationships in the panel below.
      </desc>
      <defs>
        <mask id="map-node-clearance" maskUnits="userSpaceOnUse" x="0" y="0" width={layout.width} height={layout.height} style="mask-type:luminance">
          <rect width={layout.width} height={layout.height} fill="white" />
          {layout.nodes.map(n => <rect x={n.x - 6} y={n.y - 6} width={n.w + 12} height={n.h + 12} rx="8" fill="black" />)}
        </mask>
        {drawableEdges.map((e, i) => <clipPath id={`map-terminal-${i}`} clipPathUnits="userSpaceOnUse">
          {[e.fromNode, e.toNode].map(n => <rect x={n.x - 6} y={n.y - 6} width={n.w + 12} height={n.h + 12} />)}
        </clipPath>)}
      </defs>

      {
        layout.bands.map((band, i) => (
          <line
            x1="0"
            x2={layout.width}
            y1={i === 0 ? 1 : band.y}
            y2={i === 0 ? 1 : band.y}
            class="map-row-rule"
            data-kind={band.kind}
          />
        ))
      }

      <g mask="url(#map-node-clearance)">{
        drawableEdges.map((e) => (
          <path
            d={e.d}
            class:list={['map-edge', `map-edge-${e.type.replace(/_/g, '-')}`]}
            data-from={e.from}
            data-to={e.to}
            data-type={e.type}
            data-note={e.note}
            data-when={e.when}
            data-question={e.question}
            data-covered-by-upgrade={coveredRequirements.has(e.key) ? 'true' : undefined}
          />
        ))
      }</g>
      {drawableEdges.map((e, i) => <path d={e.d} clip-path={`url(#map-terminal-${i})`}
        class:list={['map-edge', 'map-terminal', `map-edge-${e.type.replace(/_/g, '-')}`]}
        data-from={e.from} data-to={e.to} data-type={e.type}
        data-covered-by-upgrade={coveredRequirements.has(e.key) ? 'true' : undefined} />)}

      {
        layout.nodes.map((node) => (
          <a
            href={url(`/techniques/${node.slug}/`)}
            class="map-node"
            data-slug={node.slug}
            data-title={node.title}
            data-summary={node.summary}
            aria-label={`${node.title}. ${node.levelLabel}.`}
          >
            <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="6" class="map-node-body" style={`--c:${node.color}`} />
            {/* The level's hue as a solid 3px bar along the node's top edge, the same idiom
                ClimbCurve.astro's cards and the leveled page-hero use (a 2px rule in var(--oN)) --
                the band label alone was not enough for the color to "carry across the row" the
                way it does elsewhere on the site. Square corners: at this scale the sliver of
                overlap past the rect's own 6px-radius corner is under a pixel and invisible. */}
            <rect x={node.x} y={node.y} width={node.w} height="3" class="map-node-accent" style={`--c:${node.color}`} />
            <text x={node.x + node.w / 2} y={node.y + node.h / 2}>
              {node.title}
            </text>
          </a>
        ))
      }
    </svg>
  </div>
</div>

<section id="map-selection" class="map-selection panel" aria-labelledby="map-selection-title" hidden>
  <div class="eyebrow">Selected concept</div>
  <h3 id="map-selection-title"></h3>
  <p class="map-selection-summary"></p>
  <a class="button map-open-concept" href={url('/map/')}>Open concept <span aria-hidden="true">→</span></a>
  <h4>How and why they connect</h4>
  <p class="footnote">Requires marks a reading foundation. Upgrade paths are optional and depend on your task.</p>
  <ul class="map-selection-links"></ul>
</section>

</div>

</div>

<script>
  // A selected concept stays locked until another click, selector change, or explicit clear.
  // Native links remain usable without JavaScript and for modified clicks / open in new tab.
  const wrap = document.querySelector<HTMLElement>('.map-wrap');
  if (wrap) {
    // Native disclosures preserve every control; only phones start with the long guidance closed.
    const mobileMap = matchMedia('(max-width: 600px)');
    const adaptMap = () => wrap.querySelectorAll<HTMLDetailsElement>('.map-options, .map-legend').forEach(detail => { detail.open = !mobileMap.matches; });
    adaptMap();
    mobileMap.addEventListener('change', adaptMap);
    const edges = [...wrap.querySelectorAll<SVGElement>('.map-edge')];
    const nodes = [...wrap.querySelectorAll<SVGAElement>('.map-node')];
    const select = wrap.querySelector<HTMLSelectElement>('#map-focus')!;
    const status = wrap.querySelector<HTMLElement>('.map-focus-status')!;
    const clear = wrap.querySelector<HTMLButtonElement>('.map-clear')!;
    const jump = wrap.querySelector<HTMLAnchorElement>('.map-selection-jump')!;
    const panel = wrap.querySelector<HTMLElement>('.map-selection')!;
    const open = panel.querySelector<HTMLAnchorElement>('.map-open-concept')!;
    const title = panel.querySelector<HTMLElement>('h3')!;
    const summary = panel.querySelector<HTMLElement>('.map-selection-summary')!;
    const links = panel.querySelector<HTMLUListElement>('.map-selection-links')!;
    const relations = [...wrap.querySelectorAll<SVGElement>('g[mask] .map-edge')];
    const labels: Record<string, string> = { requires: 'Requires', upgrades_to: 'Upgrades to', combines_with: 'Combines with', alternative_to: 'Alternative to' };
    const bySlug = new Map(nodes.map(n => [n.dataset.slug!, n]));
    const name = (node: SVGAElement) => node.dataset.title!;
    let hovered = '', focused = '';
    function render() {
      const slug = select.value || hovered || focused;
      const related = new Set([slug]);
      wrap!.classList.toggle('map-focusing', !!slug);
      for (const edge of edges) {
        const active = !!slug && (edge.dataset.from === slug || edge.dataset.to === slug);
        edge.classList.toggle('hl', active);
        if (active) { related.add(edge.dataset.from!); related.add(edge.dataset.to!); }
      }
      for (const node of nodes) {
        node.classList.toggle('map-related', related.has(node.dataset.slug!));
        node.classList.toggle('map-selected', node.dataset.slug === slug);
        node.setAttribute('aria-pressed', String(node.dataset.slug === select.value));
      }
    }
    function selectConcept(slug: string) {
      select.value = slug;
      hovered = focused = '';
      render();
      const node = bySlug.get(slug);
      clear.hidden = jump.hidden = panel.hidden = !node;
      links.replaceChildren();
      panel.scrollTop = 0;
      if (!node) {
        status.textContent = 'Hover to explore. Click a concept to lock its connections, then open its page in the selection panel.';
        return;
      }
      const nodeName = name(node);
      status.textContent = `${nodeName} selected. Connections stay locked. Open concept in the selection panel, select another box, or clear selection.`;
      title.textContent = nodeName;
      summary.textContent = node.dataset.summary!;
      open.href = node.getAttribute('href')!;
      open.setAttribute('aria-label', `Open concept: ${nodeName}`);
      for (const edge of relations) {
        const { from, to, type, note, when, question } = edge.dataset;
        if (from !== slug && to !== slug) continue;
        const other = bySlug.get(from === slug ? to! : from!)!;
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = other.getAttribute('href')!;
        link.textContent = name(other);
        const label = from === slug || type === 'combines_with' || type === 'alternative_to'
          ? labels[type!] : type === 'requires' ? 'Required by' : 'Upgrade from';
        const swatch = document.createElement('span');
        swatch.className = 'map-swatch';
        swatch.dataset.type = type;
        swatch.setAttribute('aria-hidden', 'true');
        const heading = document.createElement('div');
        heading.className = 'map-connection-heading';
        heading.append(swatch, `${label}: `, link);
        li.append(heading);
        for (const text of [note, when && `Consider this upgrade when: ${when}`, question && `Decision: ${question}`]) {
          if (!text) continue;
          const detail = document.createElement('small');
          detail.textContent = text;
          li.append(detail);
        }
        links.append(li);
      }
      if (!links.children.length) {
        const empty = document.createElement('li');
        empty.textContent = 'No direct connections are recorded for this overview yet. Open the concept to explore its topics.';
        links.append(empty);
      }
    }
    select.disabled = false;
    select.addEventListener('change', () => {
      selectConcept(select.value);

    });
    clear.addEventListener('click', () => { selectConcept(''); select.focus(); });
    nodes.forEach(node => {
      node.setAttribute('role', 'button');
      node.setAttribute('aria-pressed', 'false');
      node.setAttribute('aria-controls', 'map-selection');
      node.addEventListener('keydown', event => {
        if (event.key !== ' ') return;
        event.preventDefault(); selectConcept(node.dataset.slug!);
      });
      node.addEventListener('click', event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        selectConcept(node.dataset.slug!);
      });
      node.addEventListener('mouseenter', () => { hovered = node.dataset.slug!; render(); });
      node.addEventListener('mouseleave', () => { hovered = ''; render(); });
      node.addEventListener('focus', () => { focused = node.dataset.slug!; render(); });
      node.addEventListener('blur', () => { focused = ''; render(); });
    });
  }
</script>

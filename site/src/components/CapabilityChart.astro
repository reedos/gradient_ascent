---
// Epoch AI's Epoch Capabilities Index by model release date, the frontier over it, and this
// site's level dates and the reasoning-models shift marked against it. Static SVG built at build
// time from content/capability.json (scripts/import_eci.py refreshes it). A small script selects records.
//
// The scores are Epoch's, reused under CC BY 4.0 and credited under the chart. This site draws
// them, draws their running maximum, and does one subtraction for the caption, labeled as its own.
import snapshotData from '../../../content/capability.json';
import { usDate } from '../lib/dates';
import { url } from '../lib/url';
import { formatDate, levelSeries, shifts, milestone as milestoneById, asOf } from '../lib/timeline';
import { levels as taxonomyLevels } from '../lib/content';
import {
  frontier,
  frontierAt,
  frontierChange,
  frontierPath,
  labeledFrontier,
  makeScale,
  sx,
  sy,
  yearOf,
  type CapabilitySnapshot,
} from '../lib/capability';
import '../styles/capability.css';

const snap = snapshotData as unknown as CapabilitySnapshot;
const W = 1000;
const H = 496;
const START = '2022-10-01';
const scale = makeScale(snap.points, { startISO: START, endISO: asOf, width: W, height: H, pad: { l: 44, r: 18, t: 30, b: 112 } });
const front = frontier(snap.points);
const path = frontierPath(scale, front, asOf);
const named = labeledFrontier(scale, front, 92, ['Claude 3 Opus', 'Claude Fable 5']);
const r1 = (n: number) => Math.round(n * 10) / 10;

const yTicks: number[] = [];
for (let v = scale.y0; v <= scale.y1; v += 20) yTicks.push(v);
const years: number[] = [];
for (let y = Math.ceil(scale.x0); y <= Math.floor(scale.x1); y++) years.push(y);

// This site's own dates, along the bottom: selected milestones for each level.
const levelMarks = levelSeries()
  .map((s) => ({ level: s.level, mark: s.marks.find((m) => m.key === 'available') }))
  .filter((x) => x.mark && x.mark.milestone.date >= START)
  .map((x) => ({
    level: x.level,
    title: taxonomyLevels.find((t) => t.order === x.level)?.title ?? `Level ${x.level}`,
    product: x.mark!.milestone.short ?? x.mark!.milestone.title,
    date: x.mark!.milestone.date,
    x: r1(sx(scale, yearOf(x.mark!.milestone.date))),
    row: 0,
  }));
// Two levels can launch within days of each other (3 and 4 did). A marker that would sit on its
// neighbor drops to a second row.
for (let i = 1; i < levelMarks.length; i++) {
  if (levelMarks[i].x - levelMarks[i - 1].x < 22 && levelMarks[i - 1].row === 0) levelMarks[i].row = 1;
}

const reasoning = shifts.find((s) => s.id === 'reasoning-models');
const reasoningM = reasoning ? milestoneById(reasoning.milestone) : undefined;
const shiftX = reasoningM ? r1(sx(scale, yearOf(reasoningM.date))) : undefined;

// The caption's two figures. Anchored on two named releases, not on a window chosen to flatter:
// from GPT-4 to the day before the first reasoning model, and from that day to the snapshot.
const gpt4 = front.find((p) => p.name.startsWith('GPT-4 (Mar 2023)')) ?? front[0];
const dayBefore = (iso: string) => new Date(Date.parse(`${iso}T00:00:00Z`) - 86_400_000).toISOString().slice(0, 10);
const before = reasoningM ? frontierChange(front, gpt4.date, dayBefore(reasoningM.date)) : null;
const after = reasoningM ? frontierChange(front, dayBefore(reasoningM.date), asOf) : null;
const top = front[front.length - 1];
const longDate = (iso: string) => formatDate(iso, 'day');
const initialRecord = Math.max(0, front.findIndex(p => p.name === 'Claude Fable 5'));
const recordDetails = front.map((p, i) => `${p.org ?? 'Unknown maker'} · ECI ${p.eci} · Highest score ${longDate(p.date)}–${longDate(front[i+1] ? dayBefore(front[i+1].date) : snap.retrieved)}`);
// Mobile gets its own plot coordinates, not a scaled-down copy of desktop's tiny labels.
const mobileScale = makeScale(snap.points, { startISO: START, endISO: asOf, width: 440, height: 370, pad: { l: 38, r: 14, t: 36, b: 78 } });
const mobileMarks = levelMarks.map(m => ({ ...m, x: r1(sx(mobileScale, yearOf(m.date))), row: 0 }));
const mobileLabelX = new Map<number, number>();
let previousLabelX = mobileScale.left - 28;
for (const m of [...mobileMarks].sort((a,b)=>a.x-b.x)) {
  const labelX = Math.max(m.x, previousLabelX + 28);
  mobileLabelX.set(m.level, labelX);
  previousLabelX = labelX;
}
const charts = [
  {mobile:false, W, H, scale, path, named, levelMarks, shiftX, suffix:''},
  {mobile:true, W:440, H:370, scale:mobileScale, path:frontierPath(mobileScale,front,asOf), named:labeledFrontier(mobileScale,front,125,['Claude Fable 5']), levelMarks:mobileMarks, shiftX:reasoningM?r1(sx(mobileScale,yearOf(reasoningM.date))):undefined, suffix:'-mobile'},
];
---

<figure class="cap">
  <div class="cap-scroll">
    {charts.map(({mobile,W,H,scale,path,named,levelMarks,shiftX,suffix}) => (
    <svg class:list={['cap-svg', mobile ? 'cap-svg-mobile' : 'cap-svg-desktop']} viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby={`cap-title${suffix} cap-desc${suffix}`}>
      <title id={`cap-title${suffix}`}>Epoch Capabilities Index by model release date, {Math.ceil(scale.x0)} to {usDate(asOf)}</title>
      <desc id={`cap-desc${suffix}`}>
        {snap.points.length} models scored by Epoch AI, plotted by release date. A stepped line follows the best score to date, from {front[0].eci} to {top.eci}. Markers under the axis show selected milestones for this site's levels, and a vertical line marks the first reasoning model.
      </desc>
      <defs>
        <linearGradient id={`cap-grad${suffix}`} x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="var(--mk1)" />
          <stop offset=".4" stop-color="var(--mk2)" />
          <stop offset=".75" stop-color="var(--mk3)" />
          <stop offset="1" stop-color="var(--mk4)" />
        </linearGradient>
      </defs>

      {yTicks.map((v) => (
        <g>
          <line class="cap-grid" x1={scale.left} x2={scale.right} y1={r1(sy(scale, v))} y2={r1(sy(scale, v))} />
          <text class="cap-tick" x={scale.left - 8} y={r1(sy(scale, v)) + 3.5} text-anchor="end">{v}</text>
        </g>
      ))}
      {years.map((y) => (
        <g>
          <line class="cap-grid is-v" x1={r1(sx(scale, y))} x2={r1(sx(scale, y))} y1={scale.top} y2={scale.bottom} />
          <text class="cap-tick" x={r1(sx(scale, y))} y={scale.bottom + 16} text-anchor="middle">{y}</text>
        </g>
      ))}
      <text class="cap-axis" x={scale.left - 34} y={scale.top - 12}>ECI score</text>

      {shiftX !== undefined && reasoningM && (
        <g>
          <line class="cap-shift" x1={shiftX} x2={shiftX} y1={scale.top - 6} y2={scale.bottom} />
          <text class="cap-shift-label" x={shiftX - 7} y={scale.top + 4} text-anchor="end">{mobile?'Reasoning':'First reasoning model'} · {formatDate(reasoningM.date.slice(0, 7), 'month')}</text>
        </g>
      )}

      <g class="cap-points">
        {snap.points.map((p) => (
          <circle class:list={['cap-dot', p.open && 'is-open']} cx={r1(sx(scale, yearOf(p.date)))} cy={r1(sy(scale, p.eci))} r="2.7">
            <title>{`${p.name}${p.org ? `, ${p.org}` : ''} · ${p.eci} · ${usDate(p.date)}`}</title>
          </circle>
        ))}
      </g>

      <path class="cap-frontier" d={path} stroke={`url(#cap-grad${suffix})`} fill="none" />
      {front.map((p, i) => (
        <g class="cap-record" role="button" tabindex="0" data-record-index={i} aria-pressed={i === initialRecord ? 'true' : 'false'} aria-label={`${p.name}, ECI ${p.eci}. Show record details`}>
        <circle class="cap-record-hit" cx={r1(sx(scale, yearOf(p.date)))} cy={r1(sy(scale, p.eci))} r="12" />
        <circle class="cap-front-dot" cx={r1(sx(scale, yearOf(p.date)))} cy={r1(sy(scale, p.eci))} r="3.4">
          <title>{`New high: ${p.name}${p.org ? `, ${p.org}` : ''} · ${p.eci} · ${usDate(p.date)}`}</title>
        </circle>
        </g>
      ))}
      {named.map((p,i) => {
        const x = r1(sx(scale, yearOf(p.date)));
        const y = r1(sy(scale, p.eci));
        return <g class="cap-callout">
          <text class="cap-name" x={x + (mobile && i===0 ? 6 : -6)} y={y - (p === top ? 28 : 8)} text-anchor={mobile && i===0?'start':'end'}>{p.name === 'Claude Fable 5' ? 'Fable 5' : p.name.replace(/ \(.*\)$/, '')}</text>
        </g>;
      })}

      {levelMarks.map((m) => (
        <a href={url(`/levels/${m.level}/`)} class="cap-level" style={`--c:var(--o${m.level})`} aria-label={`Level ${m.level}, ${m.title}: ${m.product}, ${longDate(m.date)}`}>
          <line x1={m.x} x2={mobile?mobileLabelX.get(m.level):m.x} y1={scale.bottom} y2={scale.bottom + (mobile?39:52) + m.row * 24} />
          <circle cx={mobile?mobileLabelX.get(m.level):m.x} cy={scale.bottom + (mobile?50:62) + m.row * 24} r={mobile?11:9} />
          <text x={mobile?mobileLabelX.get(m.level):m.x} y={scale.bottom + (mobile?54:66) + m.row * 24} text-anchor="middle">{m.level}</text>
          <title>{`Level ${m.level}, ${m.title}: ${m.product}, ${longDate(m.date)}`}</title>
        </a>
      ))}
      <text class="cap-axis is-halo" x={scale.right} y={scale.bottom + (mobile?76:38)} text-anchor="end">Selected milestones by level</text>
    </svg>
    ))}
  </div>

  <ul class="cap-legend">
    <li><span class="cap-key is-closed" /> A model, closed weights</li>
    <li><span class="cap-key is-open" /> A model, open weights</li>
    <li><span class="cap-key is-line" /> Best score to date</li>
    <li><span class="cap-key is-level" /> A selected milestone for a level</li>
  </ul>
  <div class="cap-inspector">
    <label>Explore a record
      <select class="cap-record-select" aria-label="Explore a capability record">
        {front.map((p,i) => <option value={i} selected={i === initialRecord} data-detail={recordDetails[i]}>{p.name}</option>)}
      </select>
    </label>
    <p class="cap-record-detail" aria-live="polite">{recordDetails[initialRecord]}</p>
  </div>

  <figcaption>
    <p>
      {snap.what_it_is.replace(/^The Epoch Capabilities Index \(ECI\)/, 'Epoch AI’s Capabilities Index')} Epoch adds that
      “Absolute ECI values are meaningless by themselves, but meaningful comparisons can be made between models.”
      So read the shape, not the numbers.
      Record periods are reconstructed from this snapshot’s scores and release dates, not historical leaderboard snapshots. Highest ECI does not mean best at every task.
    </p>
    {before && after && reasoningM && (
      <p>
        The shape has a bend in it. From {gpt4.name.replace(/ \(.*\)$/, '')} on {longDate(gpt4.date)} to the day before the first
        reasoning model, {before.months} months, the best score rose {before.points} points, from {before.from} to {before.to}. In the {after.months} months
        since, it has risen {after.points}, to {top.eci} ({top.name}, {longDate(top.date)}). The selected milestones for levels 1 to 4 fall
        before the bend; the selected milestones for levels 5 to 7 fall after it. This reflects the editorial selection, not the first emergence of those patterns. Both figures are this
        site’s subtraction over Epoch’s scores. The index starts in early 2023, so it says nothing about what came before.
      </p>
    )}
    <details class="cap-table">
      <summary>The {front.length} models that set a new high</summary>
      <div class="cap-table-scroll">
        <table>
          <thead><tr><th>Released</th><th>Model</th><th>Maker</th><th>Score</th></tr></thead>
          <tbody>
            {front.map((p) => (
              <tr><td>{usDate(p.date)}</td><td>{p.name}</td><td>{p.org ?? '—'}</td><td>{p.eci}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
    <p class="cap-credit">
      Data: <a href={snap.source.url} rel="noopener">{snap.source.title}</a>, {snap.source.publisher}, reused under{' '}
      <a href={snap.source.license_url} rel="noopener">{snap.source.license}</a>, retrieved {usDate(snap.retrieved)}; {snap.points.length} models.
      Scores, release dates and makers are Epoch’s, unchanged apart from rounding. The level markers and the reasoning line are this site’s.
      Best score on the day of the snapshot: {frontierAt(front, asOf)}.
    </p>
  </figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.cap').forEach(chart => {
    const select = chart.querySelector<HTMLSelectElement>('.cap-record-select');
    const detail = chart.querySelector<HTMLElement>('.cap-record-detail');
    if (!select || !detail) return;
    const records = chart.querySelectorAll<SVGGElement>('[data-record-index]');
    const show = (index: string) => {
      select.value = index;
      detail.textContent = select.selectedOptions[0]?.dataset.detail ?? '';
      records.forEach(record => record.setAttribute('aria-pressed', String(record.dataset.recordIndex === index)));
    };
    select.addEventListener('change', () => show(select.value));
    records.forEach(record => {
      record.addEventListener('click', () => show(record.dataset.recordIndex!));
      record.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          show(record.dataset.recordIndex!);
        }
      });
    });
  });
</script>

<div id="acronym-tooltip" role="tooltip" hidden></div>
<script>
  import { acronyms, acronymMatches } from '../lib/acronyms';

  const main = document.querySelector('main');
  const tooltip = document.querySelector<HTMLElement>('#acronym-tooltip')!;
  // Keep titles, navigation, code, and interactive content free of definition controls.
  const excluded = 'h1,h2,h3,h4,h5,h6,[role=heading],a,button,abbr,code,pre,kbd,samp,script,style,svg,math,textarea,input,select,summary,nav,astro-island,[contenteditable],[data-no-acronyms]';
  if (main) {
    const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
    const nodes: Text[] = [];
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      if (node.parentElement && !node.parentElement.closest(excluded) &&
          node.parentElement.closest('p,li,td,th,dd,figcaption,.test-harness,[data-definition-text]')) nodes.push(node);
    }
    for (const node of nodes) {
      const text = node.data;
      const matches = acronymMatches(text);
      if (!matches.length) continue;
      const fragment = document.createDocumentFragment();
      let cursor = 0;
      for (const match of matches) {
        fragment.append(text.slice(cursor, match.index));
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'acronym-hint';
        button.dataset.acronym = match.key;
        button.textContent = match.text;
        button.setAttribute('aria-label', `${match.text}: ${acronyms[match.key][0]}. Show definition`);
        fragment.append(button);
        cursor = match.index + match.text.length;
      }
      fragment.append(text.slice(cursor));
      node.replaceWith(fragment);
    }
  }

  // Keep links as links; a separate button supplies touch and keyboard access to the definition.
  main?.querySelectorAll<HTMLAnchorElement>('a').forEach(link => {
    if (link.closest('h1,h2,h3,h4,h5,h6,[role=heading],nav,astro-island,[data-no-acronyms]') || !link.closest('p,li,td,th,figcaption')) return;
    const matches = acronymMatches(link.textContent ?? '');
    const primary = matches.find(m => m.key === 'GraphRAG' || m.key === 'RAG') ?? matches[0];
    const unique = primary ? [primary.key] : [];
    unique.forEach(key => {
      const hint = document.createElement('button');
      hint.type = 'button';
      hint.className = 'acronym-hint definition-help';
      hint.dataset.acronym = key;
      hint.textContent = '?';
      hint.setAttribute('aria-label', `${key}: ${acronyms[key][0]}. Show definition`);
      link.after(hint);
    });
    if (unique.length === 1) link.dataset.definitionKey = unique[0];
  });

  let active: HTMLElement | null = null;
  let pinned = false;
  let timer: ReturnType<typeof setTimeout>;
  function hide() {
    clearTimeout(timer);
    active?.removeAttribute('aria-describedby');
    active = null;
    pinned = false;
    tooltip.hidden = true;
  }
  function show(target: HTMLElement) {
    clearTimeout(timer);
    if (active !== target) { hide(); active = target; }
    const [expansion, definition] = acronyms[target.dataset.acronym ?? target.dataset.definitionKey!];
    const title = document.createElement('strong');
    title.textContent = expansion;
    const body = document.createElement('span');
    body.textContent = definition;
    tooltip.replaceChildren(title, body);
    tooltip.hidden = false;
    target.setAttribute('aria-describedby', tooltip.id);
    const rect = target.getBoundingClientRect();
    const box = tooltip.getBoundingClientRect();
    tooltip.style.left = `${Math.max(12, Math.min(rect.left, innerWidth - box.width - 12))}px`;
    const top = rect.top - box.height - 8;
    tooltip.style.top = `${Math.max(12, Math.min(top >= 12 ? top : rect.bottom + 8, innerHeight - box.height - 12))}px`;
  }
  function leave() {
    clearTimeout(timer);
    timer = setTimeout(() => {
      if (!pinned && document.activeElement !== active) hide();
    }, 180);
  }
  document.querySelectorAll<HTMLElement>('.acronym-hint').forEach(target => {
    target.addEventListener('pointerenter', event => { if (event.pointerType !== 'touch') show(target); });
    target.addEventListener('pointerleave', leave);
    target.addEventListener('focus', () => show(target));
    target.addEventListener('blur', hide);
    target.addEventListener('click', () => {
      if (active === target && pinned) hide();
      else { show(target); pinned = true; }
    });
  });
  main?.querySelectorAll<HTMLElement>('a[data-definition-key]').forEach(link => {
    link.addEventListener('pointerenter', () => show(link));
    link.addEventListener('pointerleave', leave);
    link.addEventListener('focus', () => show(link));
    link.addEventListener('blur', hide);
  });
  tooltip.addEventListener('pointerenter', () => clearTimeout(timer));
  tooltip.addEventListener('pointerleave', leave);
  document.addEventListener('keydown', event => { if (event.key === 'Escape') hide(); });
  document.addEventListener('pointerdown', event => {
    if (event.target instanceof Node && !active?.contains(event.target) && !tooltip.contains(event.target)) hide();
  });
  window.addEventListener('resize', hide);
  document.addEventListener('scroll', hide, true);
</script>
<style is:global>
  button.acronym-hint {
    display: inline; padding: 0; margin: 0; border: 0; border-radius: 0;
    background: transparent; color: inherit; font: inherit; letter-spacing: inherit;
    text-transform: inherit; line-height: inherit; cursor: help;
    text-decoration: underline dotted; text-underline-offset: 4px;
  }
  button.definition-help { margin-left: .35em; font-size: 12px; vertical-align: middle; border: 1px solid var(--line); border-radius: 50%; width: 18px; height: 18px; line-height: 16px; text-align: center; text-decoration: none; color: var(--muted); }
  button.acronym-hint:focus-visible { outline: 2px solid var(--accent, #4e7aff); outline-offset: 3px; }
  #acronym-tooltip {
    position: fixed; z-index: 1000; width: 300px; max-width: calc(100vw - 24px);
    box-sizing: border-box; padding: 14px 16px; border: 1px solid var(--line);
    border-radius: 8px; background: var(--panel2); color: var(--text);
    box-shadow: 0 8px 28px #0006; font-size: 14px; line-height: 1.55;
  }
  #acronym-tooltip[hidden] { display: none; }
  #acronym-tooltip strong { display: block; margin-bottom: 5px; }
  #acronym-tooltip span { color: var(--muted); }
  @media print {
    #acronym-tooltip { display: none !important; }
    button.acronym-hint { display: inline !important; color: inherit; text-decoration: none; }
  }
</style>

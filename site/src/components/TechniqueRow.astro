---
import Pill from './Pill.astro';
import { url } from '../lib/url';
import type { Status } from '../lib/content';

interface Props {
  slug: string;
  title: string;
  summary: string;
  status: Status;
  /** Heading level, so the row nests correctly under whatever heading precedes it. */
  as?: 'h3' | 'h4';
  /** A level colour token, e.g. "var(--o2)" or "var(--ot)" for tracks. Draws a small dot before
   *  the title, the way the recipe row draws one per level it touches. Optional so callers that
   *  already show the level elsewhere (a single-level panel) are not forced to repeat it. */
  color?: string;
  /** Where the title links. Defaults to this slug's technique page; a thread or any other page
   *  kind that wants the same row passes its own path. */
  href?: string;
  /** Indents the row, for a page listed under the topic page it belongs to. */
  sub?: boolean;
}
const { slug, title, summary, status, as: Heading = 'h3', color, href, sub } = Astro.props;
const target = href ?? url(`/techniques/${slug}/`);
---
<div class:list={['pattern-row', sub && 'sub']}>
  <Heading>
    {color && <i class="row-dot" style={`--c:${color}`}></i>}
    <a href={target}>{title}</a>
  </Heading>
  <Pill status={status} />
  <p>{summary}</p>
</div>

---
interface Props { name: 'use' | 'build'; title: string }
const { name } = Astro.props;
---
{name === 'build' ? (
  <details class="optional-detail lane-panel" data-lane="build" id="lane-build">
    <summary>Implementation details</summary>
    <div class="lane-body"><slot /></div>
  </details>
) : (
  <section class="lane-panel" data-lane="use" aria-labelledby="lane-use">
    <h2 id="lane-use">Practical guidance</h2>
    <div class="lane-body"><slot /></div>
  </section>
)}
<script>
  // Keep old heading bookmarks useful even when the target is inside a disclosure.
  const reveal = () => {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!target) return;
    let parent: HTMLElement | null = target;
    while (parent) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
      parent = parent.parentElement;
    }
  };
  addEventListener('hashchange', reveal);
  reveal();
</script>

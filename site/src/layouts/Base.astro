---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AcronymHints from '../components/AcronymHints.astro';
import '../styles/global.css';
import '../styles/print.css'; // finish-indexes: the print handout stylesheet, see its own file comment
import { url } from '../lib/url';
import { feedbackUrl, INDEXABLE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Leave the canonical tag off. Only /404.html wants this: GitHub Pages serves that file at
   *  every missing address, so its own canonical would name /404/, which is not a built page. */
  noCanonical?: boolean;
}
const { title, description, noCanonical = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const feedback = feedbackUrl(canonical, title);
// Link previews need an absolute image URL; most scrapers will not resolve a relative one.
const ogImage = new URL(url('/og.png'), Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0f17" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Gradient Ascent" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gradient Ascent: every way to work with AI, from a question to a workforce." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Only the font weights actually set in the stylesheets or an island's inline style are
        requested: DM Sans 400/500/550/600/650 and Manrope 450/500/550/750. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;550;600;650&family=Manrope:wght@450;500;550;750&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <aside class="page-feedback" aria-label="Feedback on this page">
      <p>
        <b>Something wrong, unclear or missing on this page?</b>
        Every claim here is meant to be checked against its source. If one is off, say so.
      </p>
      <a class="page-feedback-link" href={feedback} rel="noopener">Give feedback on this page <span aria-hidden="true">&rarr;</span></a>
    </aside>
    <Footer />
    <AcronymHints />
  </body>
</html>

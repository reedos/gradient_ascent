---
import Base from '../../layouts/Base.astro';
import PageContents from '../../components/PageContents.astro';
import { inlineHtml } from '../../lib/agents';
import { absFor } from '../../lib/agents-data';
import { url } from '../../lib/url';
import { reviewTitle, reviewIntro, reviewSteps, reviewSections, teamRoles } from '../../lib/reviewer-loop';
const allSections = reviewSections(absFor(Astro.site));
const primaryIds = ['start', 'coordination', 'user-view', 'example', 'concepts'];
const sections = primaryIds.map(id => allSections.find(s => s.id === id)!);
const supporting = allSections.filter(s => !primaryIds.includes(s.id));
---
<Base title={`${reviewTitle} · Gradient Ascent`} description={reviewIntro}>
  <div class="page-hero"><div class="eyebrow">Teams of agents · application example</div><h1>{reviewTitle}</h1><p>{reviewIntro}</p>
    <div class="review-actions"><a class="button" href={url('/examples/reviewer-feedback-loop.md')} download>Download example & role prompts</a><a href="#example">Follow a task through the team →</a></div>
  </div>
  <figure class="team-map"><figcaption>The application’s team</figcaption><div class="team-user">You: describe the goal · answer consequential questions · review the result</div><div class="team-connection" aria-hidden="true">↕</div><article class="team-lead"><h2>{teamRoles[0].title}</h2><p>{teamRoles[0].text}</p></article><p class="team-routing">↓ Delegates tasks and context · receives proposals and findings ↑</p><div class="team-workers">{teamRoles.slice(1).map(role => <article><h2>{role.title}</h2><p>{role.text}</p></article>)}</div><p class="loop-return">Brief → parallel proposals → independent findings → lead → targeted revision or result for you</p></figure>
  <figure class="review-flow"><figcaption>How one round unfolds</figcaption><ol>{reviewSteps.map((step, i) => <li><span class="eyebrow">{String(i + 1).padStart(2, '0')}</span><h2>{step.title}</h2><p>{step.text}</p></li>)}</ol></figure>
  <PageContents items={[...sections.map(s => ({ id: s.id, label: s.title })), {id:'supporting', label:'Supporting evaluation method'}]}>
    <div class="review-guide">{sections.map(section => <section id={section.id}><h2>{section.title}</h2>{section.blocks.map(b => {
      if (b.kind === 'h2') return <h2>{b.text}</h2>;
      if (b.kind === 'h3') return <h3>{b.text}</h3>;
      if (b.kind === 'p') return <p set:html={inlineHtml(b.text)} />;
      if (b.kind === 'ul') return <ul>{b.items.map(t => <li set:html={inlineHtml(t)} />)}</ul>;
      if (b.kind === 'ol') return <ol>{b.items.map(t => <li set:html={inlineHtml(t)} />)}</ol>;
      return <pre tabindex="0">{b.text}</pre>;
    })}</section>)}
    <section id="supporting"><h2>Supporting evaluation method</h2><p>The team is the application. These supporting notes explain how to check its quality, use multiple providers, and avoid the failures identified in our, Muse’s, and Grok Bot’s evaluations.</p>{supporting.map(section => <details id={section.id}><summary>{section.title}</summary>{section.blocks.map(b => {
      if (b.kind === 'h2' || b.kind === 'h3') return <h3>{b.text}</h3>;
      if (b.kind === 'p') return <p set:html={inlineHtml(b.text)} />;
      if (b.kind === 'ul' || b.kind === 'ol') return <ul>{b.items.map(t => <li set:html={inlineHtml(t)} />)}</ul>;
      return <pre tabindex="0">{b.text}</pre>;
    })}</details>)}</section></div>
  </PageContents>
</Base>
<style>
 .review-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:26px} a:not(.button){color:var(--accent)}
 .team-map{margin:0 0 40px}.team-map figcaption{font-size:24px;margin-bottom:24px}.team-map article,.team-user{padding:24px;background:var(--panel);border:1px solid var(--line);border-radius:10px}.team-lead{max-width:720px;margin:auto;border-color:var(--accent)!important}.team-user{text-align:center;max-width:840px;margin:auto}.team-connection,.team-routing{text-align:center;color:var(--muted);padding:14px}.team-workers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.team-map h2{font-size:21px;margin:0 0 14px}.team-map p{line-height:1.75;color:var(--muted)}.review-guide details{padding:20px 0;border-top:1px solid var(--line)}.review-guide summary{cursor:pointer;font-size:19px;color:var(--text)}
 .review-flow{margin:0 0 48px}.review-flow figcaption{font-size:20px;margin-bottom:20px}.review-flow ol{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px;list-style:none;padding:0}.review-flow li{padding:22px;background:var(--panel);border:1px solid var(--line);border-radius:10px}.review-flow h2{font-size:20px;margin:14px 0}.review-flow p{font-size:15px;line-height:1.7;color:var(--muted)}.loop-return{border-left:3px solid var(--accent);padding:14px 20px}
 .review-guide{min-width:0}.review-guide section{padding:28px clamp(20px,3vw,40px);margin-bottom:24px;background:var(--panel);border:1px solid var(--line);border-radius:10px;scroll-margin-top:180px}.review-guide h2{font-size:28px;margin:0 0 24px}.review-guide h3{font-size:21px;margin:30px 0 14px}.review-guide p,.review-guide li{line-height:1.8;color:var(--muted)}.review-guide p{margin:16px 0}.review-guide li{margin:12px 0}.review-guide ul,.review-guide ol{padding-left:24px}.review-guide pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:22px;background:var(--bg);border:1px solid var(--line);border-radius:8px;font-size:14px;line-height:1.7;margin:20px 0}.review-guide :global(a){color:var(--accent);overflow-wrap:anywhere}
 @media(max-width:1100px){.review-flow ol{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:650px){.team-workers{grid-template-columns:1fr}.review-flow ol{grid-template-columns:1fr}.review-flow li{padding:18px}.review-guide h2{font-size:24px}}
</style>

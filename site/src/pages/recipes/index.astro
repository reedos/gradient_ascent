---
import Base from '../../layouts/Base.astro';
import RecipeRow from '../../components/RecipeRow.astro';
import RecipeMatrix from '../../components/RecipeMatrix.astro';
import SectionTop from '../../components/SectionTop.astro';
import { recipes, recipesInDomain, recipeLevels, allTechniqueSlugs, techniqueBySlug } from '../../lib/content';

// The matrix takes plain data, not taxonomy objects (see lib/matrix.ts), so it is shaped here.
const matrixTechniques = allTechniqueSlugs
  .map((slug) => techniqueBySlug(slug)!)
  .map((t) => ({ slug: t.slug, title: t.title, level: t.level }));
const matrixRecipes = recipes.map((r) => ({ slug: r.slug, title: r.title, uses: r.uses }));
const usedSlugs = new Set(recipes.flatMap((r) => r.uses));
const columnCount = matrixTechniques.filter((t) => usedSlugs.has(t.slug)).length;

// Two audiences, one list each. The order inside a group is the taxonomy's order, so the recipe
// a group is meant to be read first stays first.
const engineering = recipesInDomain('engineering');
const general = recipesInDomain('general');
---
<Base
  title="Recipes · Gradient Ascent"
  description="Common tasks and the levels they need. Each recipe lists the techniques it uses and why it does not need a higher level."
>
  <div class="page-hero">
    <div class="eyebrow muted"><span class="dot"></span>Recipes</div>
    <h1>Common tasks and the levels they need</h1>
    <p>A recipe is a use case composed from techniques, with the reasoning for each choice. Every recipe names the techniques it uses.</p>
  </div>

  <section class="section">
    <SectionTop
      eyebrow="For engineers"
      title="For engineers: test, measurement, design and software"
      aside={`${engineering.length} recipes, all drafts. They run on one bench: an invented regulator board, four instruments with a SCPI command set, a production test specification and a month of test data. The first one uses no model at all, which is the honest starting point for most test automation.`}
    />
    <div class="signal-list">
      {
        engineering.map((r) => (
          <RecipeRow
            slug={r.slug}
            title={r.title}
            summary={r.summary}
            levels={recipeLevels(r)}
          />
        ))
      }
    </div>
  </section>

  <section class="section">
    <SectionTop
      eyebrow="Everyday jobs"
      title="For everyone: documents, mail, notes and teams"
      aside={`${general.length} recipes, all drafts. The left column lists the levels a recipe draws on; the right names the highest one it needs.`}
    />
    <div class="signal-list">
      {
        general.map((r) => (
          <RecipeRow
            slug={r.slug}
            title={r.title}
            summary={r.summary}
            levels={recipeLevels(r)}
            meta={r.running_task ? 'Used as the running example' : undefined}
          />
        ))
      }
    </div>
  </section>

  <section class="section">
    <SectionTop
      eyebrow="Use case × pattern"
      title={`${recipes.length} recipes across ${columnCount} techniques`}
      aside={`Both domains in one grid. Every technique some recipe uses gets a column, grouped and colored by level; the ${matrixTechniques.length - columnCount} pages no recipe uses are left out. A filled cell means that recipe uses that technique. The grid scrolls sideways inside its own box; on a narrow screen it is a list instead.`}
    />
    <RecipeMatrix recipes={matrixRecipes} techniques={matrixTechniques} />
    <p class="footnote reading">
      The columns say which techniques earn their place across many jobs and which are specialized.
      A recipe's own page gives the reasoning for each choice, and says why it does not need a
      higher level.
    </p>
  </section>
</Base>

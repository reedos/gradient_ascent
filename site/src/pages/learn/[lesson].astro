---
import Base from '../../layouts/Base.astro';
import LearningProgress from '../../components/LearningProgress.astro';
import LearningLab from '../../components/islands/LearningLab';
import LearningProject from '../../components/islands/LearningProject';
import { lessons, learningStages } from '../../lib/learning';
import { techniqueBySlug } from '../../lib/content';
import { url } from '../../lib/url';
import '../../styles/learning.css';
export function getStaticPaths() { return lessons.map((lesson, index) => ({params: {lesson: lesson.id}, props: {lesson, index}})); }
const { lesson, index } = Astro.props;
const stage = learningStages[lesson.stage];
const previous = lessons[index - 1];
const next = lessons[index + 1];
const lastInStage = !next || next.stage !== lesson.stage;
---
<Base title={`${lesson.title} · Learn · Gradient Ascent`} description={lesson.objective}>
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href={url('/learn/')}>Learning path</a><span>/</span><a href={url(`/learn/#stage-${lesson.stage + 1}`)}>{stage.title}</a></nav>
  <div class="page-hero">
    <div class="eyebrow">Lesson {index + 1} of {lessons.length} · Stage {lesson.stage + 1} · About {lesson.minutes} minutes</div>
    <h1>{lesson.title}</h1><p>{lesson.objective}</p>
  </div>
  <div class="learn-layout">
    <article class="lesson-body">
      <aside class="lesson-before"><strong>Before this lesson</strong><p>{previous ? <>Build on <a href={url(`/learn/${previous.id}/`)}>{previous.title}</a>. Review it if the terms here feel unfamiliar.</> : 'No prior AI or programming experience is required. Start with a task you can check yourself.'}</p></aside>
      <h2>The idea</h2>{lesson.teaching.map(p => <p>{p}</p>)}
      <div class="worked-example"><h2>Worked example</h2><p>{lesson.example}</p></div>
      <section class="lesson-check" aria-labelledby="check-heading">
        <h2 id="check-heading">Check your understanding</h2><p>{lesson.exercise}</p>
        <p class="footnote">Form an answer before opening the explanation. Nothing needs to be submitted.</p>
        <details><summary>Reveal the explained answer</summary><p>{lesson.answer}</p></details>
      </section>
      <LearningLab lesson={lesson.id} client:load />
      <noscript><p>The workspace needs JavaScript to edit, simulate, save, and download. The lesson and explained answer remain readable.</p></noscript>
      {lastInStage && <LearningProject stage={stage} index={lesson.stage} client:load />}
      <LearningProgress lesson={lesson.id} />
      <nav class="lesson-pagination" aria-label="Lesson navigation">
        {previous ? <a href={url(`/learn/${previous.id}/`)}>← Previous: {previous.title}</a> : <a href={url('/learn/')}>← Path overview</a>}
        {next ? <a href={url(`/learn/${next.id}/`)}>Next lesson: {next.title} →</a> : <a href={url('/learn/')}>Finish: review the six projects →</a>}
      </nav>
    </article>
    <aside class="lesson-reading">
      <h2>Explore the concepts</h2><p>Optional deeper reading, with diagrams, examples, and primary sources. The “Build it” sections include code.</p>
      <ul>{lesson.concepts.map(slug => {const t = techniqueBySlug(slug)!; return <li><a href={url(`/techniques/${slug}/`)}>{t.title}</a><p>{t.summary}</p></li>;})}</ul>
      <a href={url('/glossary/')}>Look up a term in the glossary →</a>
    </aside>
  </div>
</Base>

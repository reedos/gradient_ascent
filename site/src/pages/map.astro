---
// /map/: the project plan promises this under "Required figures" ("The map (technique graph) | its own
// view") and under Content model / How everything connects ("a map view (the graph)") -- the one
// figure the site described from day one and never built. Every technique page as a node, laid
// out once at build time by src/lib/map.ts, with the taxonomy's typed relations as edges.
import Base from '../layouts/Base.astro';
import SectionTop from '../components/SectionTop.astro';
import TechniqueMap from '../components/TechniqueMap.astro';
import { mapLayout } from '../lib/map';
import { url } from '../lib/url';

const tierNodeCount = mapLayout.nodes.filter((n) => n.level !== 'tracks').length;
const topicNodeCount = mapLayout.nodes.length - tierNodeCount;
---
<Base
  title="Map · Gradient Ascent"
  description="Every technique in Gradient Ascent, laid out by level with the taxonomy's requires, upgrades-to, combines-with and alternative-to relations drawn between them."
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url('/')}>Home</a>
    <span aria-hidden="true">/</span>
    <span>Map</span>
  </nav>

  <div class="page-hero map-page-hero">
    <div class="eyebrow"><span class="dot"></span>Map</div>
    <h1>The whole technique graph, at a glance</h1>
    <p class="map-desktop-intro">
      Every concept page is one node, in the level it belongs to. Level 7 is at the top and
      level 0 at the bottom, the same order as the climb curve on the home page. Below them, five
      short rows hold the topics that cut across every level, one row per topic. The taxonomy's
      typed relations connect them: what to read first, when to climb, what is commonly used
      together, and what solves the same problem a different way.
    </p>
    <p class="map-mobile-intro">Explore the connections. Pinch to zoom, or choose a concept for readable details.</p>
    <div class="hero-meta">
      <span>{mapLayout.nodes.length} pages</span>
      <span>{tierNodeCount} across the eight levels</span>
      <span>{topicNodeCount} under the five topics</span>
      <span>{mapLayout.edges.length} relations</span>
    </div>
  </div>

  <section class="section map-page-section">
    <SectionTop
      eyebrow="The graph"
      title="Every technique, where it sits and what it connects to"
      aside="Requires and Upgrades to draw by default, with overlapping pairs drawn once. Hover or select a concept to reveal its supporting topics too."
    />
    <TechniqueMap />
  </section>
</Base>
<style>
 .map-mobile-intro { display: none; }
 @media (max-width: 600px) {
  .map-page-hero { padding: 16px 0 20px; }
  .map-page-hero h1 { font-size: 25px; line-height: 1.2; margin-bottom: 10px; }
  .map-desktop-intro, .map-page-hero .hero-meta, .map-page-hero .eyebrow { display: none; }
  .map-mobile-intro { display: block; font-size: 13px; line-height: 1.6; margin: 0; }
  .map-page-section { padding-top: 0; margin-top: 0; }
  .map-page-section :global(.section-top) { display: none; }
 }
</style>

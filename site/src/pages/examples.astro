---
import Base from '../layouts/Base.astro';
import entries from '../data/worked-example-proposals.json';
import { walkthroughCases, audiencesFor, examplesFor } from '../lib/walkthrough-catalog';
import { url } from '../lib/url';
import { audienceLabels } from '../lib/walkthrough';
const groups = [...new Set(entries.map(e => e.group))];
const exampleCount=walkthroughCases.length+1;
const multiCount=entries.filter(e=>audiencesFor(e.slug).length>1).length;
const exampleUrl=(entry:typeof entries[number],audience?:string)=>url(`/${entry.group==='Cross-cutting guides'?'threads':'techniques'}/${entry.slug}/${audience?'?audience='+audience:''}#${entry.slug==='agent-harness'?'worked-example-a-test-automation-framework':'guided-example'}`);
---
<Base title="Worked examples · Gradient Ascent" description="Explore concepts through everyday, engineering, and business worked examples.">
  <div class="page-hero"><div class="eyebrow">Worked examples · audience perspectives</div><h1>A worked example for every concept.</h1><p>{exampleCount} scripted examples cover 54 concepts and four cross-cutting guides. {multiCount} concepts offer all three perspectives; the rest retain a focused example. Each variation has its own task, evidence, failure case, and decision. These are teaching fixtures, not measured runs.</p></div>
  <section class="proposal-feature"><h2>Featured workflow: the weekly project status report</h2><p>Use previous reports for continuity, collect current evidence across project sources, reconcile conflicting updates, draft a report, and send only the exact version and recipient list a human approves.</p><p><strong>Collect → reconcile → draft → compare → review → approved send → record.</strong></p><p>A missing update does not mean a project is on track. An edited draft needs renewed approval. A timed-out send needs duplicate protection. The example uses fictional sources and simulated delivery.</p></section>
  <section class="proposal-feature" style="margin-top:24px"><h2>Team application: agents that improve your project brief</h2><p>A lead agent coordinates a writer, parallel receiving agents, and independent reviewers. Follow how the team finds misunderstandings, revises a brief, and returns candidate approaches and open decisions.</p><a href={url('/examples/reviewer-feedback-loop/')}>Explore the team of agents &rarr;</a></section>
  <p class="proposal-contract"><strong>Every example:</strong> English request → synchronized workflow and visible work → why it matters → inspectable evidence → change a condition → make a decision. Scripted examples, actual checks, and measured model runs must be clearly distinguished.</p>
  <label class="proposal-search">Find a concept or example <input id="proposal-search" type="search" placeholder="Try approval, status report, memory…" /></label>
  <label class="proposal-search">Audience <select id="proposal-audience"><option value="">All available examples</option><option value="everyday">Everyday life</option><option value="engineering">Engineering & technical work</option><option value="business">Business & team operations</option></select></label><p id="proposal-count" role="status">58 concepts and guides · {exampleCount} examples</p>
  <nav class="proposal-nav" aria-label="Example groups">{groups.map((g,i)=><a href={`#proposal-group-${i}`}>{g}</a>)}</nav>
  {groups.map((g,i)=><section class="proposal-group" id={`proposal-group-${i}`}><h2>{g}</h2>{entries.filter(e=>e.group===g).map(e=><article class="proposal-card" data-audiences={audiencesFor(e.slug).join(' ')}><h3>{entries.indexOf(e)+1}. {e.title}</h3><div class="proposal-perspectives">{audiencesFor(e.slug).map(a=><div><a href={exampleUrl(e,a)}>{audienceLabels[a]} →</a><p>{e.slug==='agent-harness'&&a==='engineering'?'Generate a new DUT project using the shared test automation framework.':examplesFor(e.slug).find(c=>c.audience===a)!.prompt}</p></div>)}</div><dl><dt>Definition</dt><dd>{e.definition}</dd><dt>Scenario family</dt><dd>{e.example}</dd><dt>Nuance and contrasting case</dt><dd>{e.nuance}</dd><dt>Further evidence to collect</dt><dd>{e.evidence}</dd></dl></article>)}</section>)}
</Base>
<script>
 const input=document.querySelector<HTMLInputElement>('#proposal-search')!;
 const audience=document.querySelector<HTMLSelectElement>('#proposal-audience')!;
 function filter(){
   let count=0;const query=input.value.toLowerCase().trim();
   document.querySelectorAll<HTMLElement>('.proposal-card').forEach(card=>{card.hidden=!card.textContent?.toLowerCase().includes(query)||(Boolean(audience.value)&&!card.dataset.audiences?.split(' ').includes(audience.value));if(!card.hidden)count++;});
   document.querySelectorAll<HTMLElement>('.proposal-group').forEach(group=>{group.hidden=!group.querySelector('.proposal-card:not([hidden])');});
   document.querySelector('#proposal-count')!.textContent=`${count} concepts and guides`;
 }
 input.addEventListener('input',filter);audience.addEventListener('change',filter);
</script>
<style>
 .proposal-feature { padding:24px 28px; border:1px solid var(--o5); border-radius:10px; background:var(--panel); }
 .proposal-feature h2 { margin-top:0; }.proposal-feature p,.proposal-contract { color:var(--muted); line-height:1.8; }
 .proposal-contract { margin:26px 0; }.proposal-search { display:block; font-size:14px; }
 .proposal-search input { display:block; margin-top:10px; width:min(100%,620px); padding:13px 16px; border:1px solid var(--line); border-radius:6px; background:var(--panel); color:var(--text); font:inherit; }
 .proposal-search select { margin:14px; padding:10px; background:var(--panel); border:1px solid var(--line); border-radius:6px; color:var(--text); max-width:100%; }
 #proposal-count { font-size:12px; color:var(--muted); }.proposal-nav { display:flex; flex-wrap:wrap; gap:8px 18px; margin:24px 0 38px; font-size:13px; }
 .proposal-group { scroll-margin-top:100px; margin:38px 0; }.proposal-group>h2 { font-size:24px; }
 .proposal-card { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:24px 28px; margin:16px 0; }
 .proposal-perspectives { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin:20px 0; }.proposal-perspectives>div { padding:16px; background:var(--panel2); border-radius:6px; }.proposal-perspectives a { font-size:14px; }.proposal-perspectives p { font-size:13px; line-height:1.7; color:var(--muted); margin-bottom:0; }
 .proposal-card h3 { margin:0 0 20px; font-size:21px; }.proposal-card dl { display:grid; grid-template-columns:200px 1fr; gap:14px 24px; margin:0; }
 .proposal-card dt { font-size:12px; color:var(--muted); }.proposal-card dd { margin:0; font-size:15px; line-height:1.75; }
 @media(max-width:650px) { .proposal-card dl { grid-template-columns:1fr; gap:8px; }.proposal-card dd { margin-bottom:12px; }.proposal-card { padding:20px; } }
</style>


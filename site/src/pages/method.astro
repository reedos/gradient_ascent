---
// /method/: the premise, the principles and the method. The words are in lib/method.ts, not here,
// so that the Markdown twin at /method.md serves a reader's agent exactly what a person reads.
import Base from '../layouts/Base.astro';
import { inlineHtml, type Block } from '../lib/agents';
import { absFor } from '../lib/agents-data';
import { methodSections } from '../lib/method';

const sections = methodSections(absFor(Astro.site));
---
<Base
  title="Method · Gradient Ascent"
  description="Premise, principles, method, what the registry is and is not, and what the site does not do."
>
  <div class="page-hero">
    <div class="eyebrow muted"><span class="dot"></span>Method</div>
    <h1>Why this site exists and how it works</h1>
  </div>

  <div class="prose-grid">
    <nav class="prose-nav" aria-label="On this page">
      {sections.map((s) => <a href={`#${s.id}`}>{s.nav}</a>)}
    </nav>
    <div class="prose">
      {
        sections.map((s) => (
          <>
            <h2 id={s.id}>{s.heading}</h2>
            {s.blocks.map((b: Block) => {
              if (b.kind === 'h3') return <h3>{b.text}</h3>;
              if (b.kind === 'p') return <p set:html={inlineHtml(b.text)} />;
              if (b.kind === 'ol') return <ol>{b.items.map((it) => <li set:html={inlineHtml(it)} />)}</ol>;
              if (b.kind === 'ul') return <ul>{b.items.map((it) => <li set:html={inlineHtml(it)} />)}</ul>;
              return <pre>{b.text}</pre>;
            })}
          </>
        ))
      }
      <p class="footnote">
        This page is also served as Markdown at <a href={absFor(Astro.site)('/method.md')}>/method.md</a>,
        so a reader's own agent can quote the principles rather than read the markup around them.
      </p>
    </div>
  </div>
</Base>
